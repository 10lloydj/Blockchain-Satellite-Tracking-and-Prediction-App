# N2YO API Key - Get yours at https://www.n2yo.com/api/
N2YO_API_KEY=your_n2yo_api_key_here

# Google Maps API Key (optional, for map features)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Blockchain Configuration
# For local development (Ganache):
# BLOCKCHAIN_ADDRESS=http://127.0.0.1:7545
# For production/testnet (Infura Sepolia):
# BLOCKCHAIN_ADDRESS=https://sepolia.infura.io/v3/your_infura_project_id
BLOCKCHAIN_ADDRESS=your_blockchain_rpc_url_here

# Contract address after deployment - Update this after running truffle migrate
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Path to the contract ABI - Usually don't need to change this
CONTRACT_ARTIFACT_PATH=Code/flaskr/artifacts/Satellites.json

# Default Location (Manchester, UK) - Change these to your preferred default location
DEFAULT_LATITUDE=53.48095
DEFAULT_LONGITUDE=-2.23743

# Flask Configuration
FLASK_APP=flaskr
FLASK_ENV=development
FLASK_DEBUG=1

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=satellite.log

# Flask secret key (generate your own for production)
SECRET_KEY=your_secret_key_here

# Mnemonic for deploying contracts (never commit your real mnemonic)
MNEMONIC=your_mnemonic_phrase_here

# Infura Project ID (for Sepolia or other testnets)
INFURA_PROJECT_ID=your_infura_project_id_here